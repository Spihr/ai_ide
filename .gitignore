# ---- Node / 前端 ----
node_modules/
dist/
out/
build/
*.tsbuildinfo
.vite/
coverage/

# ---- Rust ----
target/
**/*.rs.bk
*.pdb

# ts-rs 的暂存目录：pnpm types:gen 搬运到 packages/shared-types/src/generated 后会删除它，不入库
crates/protocol/bindings/

# ---- 打包产物 ----
release/
*.exe
*.msi
*.nsis

# 打包图标资源需入库（apps/desktop/electron-builder.yml 的 buildResources 指向它）：
# 由 scripts/gen-icons.mjs 生成，勿手工编辑。其中 build/core/ 是 prepack:core 产出的
# 内核二进制与 manifest（平台相关、体积大），仍不入库。
!apps/desktop/build/
apps/desktop/build/core/

# ---- 日志与运行时数据 ----
*.log
logs/
*.sqlite
*.sqlite-shm
*.sqlite-wal
data/

# ---- 环境与密钥（绝不入库）----
.env
.env.*
!.env.example
credentials.enc
*.pem
*.key

# M4 真实模型联调凭据：scripts/e2e-m4.mjs 未传 --creds 时默认读这个文件，
# 里面是本机真实厂商的 base_url + api_key，绝不入库（改动前请先读 docs/10 七-1）
.e2e-m4-credentials.json
.e2e-m4-credentials.local.json

# ---- 编辑器 ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

# ---- 系统 ----
Thumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
.DS_Store
